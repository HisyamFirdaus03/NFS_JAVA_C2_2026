### Health check
GET http://localhost:8080/api/health


### Get all assets from MongoDB
GET http://localhost:8080/api/assets


### Get one asset
# Replace the ID below with an actual ID returned by GET /api/assets
GET http://localhost:8080/api/assets/REPLACE_WITH_REAL_ID


### Get missing asset
GET http://localhost:8080/api/assets/000000000000000000000000


### Create a valid asset
POST http://localhost:8080/api/assets
Content-Type: application/json

{
  "assetTag": "TAB-2026-001",
  "name": "Samsung Galaxy Tab",
  "category": "Tablet",
  "serialNumber": "SN-TAB-001",
  "location": "HQ Level 4"
}


### Create an invalid asset
POST http://localhost:8080/api/assets
Content-Type: application/json

{
  "assetTag": "",
  "name": "",
  "category": "",
  "serialNumber": "",
  "location": ""
}


############################################################
# Tickets (Day 7 Exercise 3 - read from MongoDB)
# NOTE: this app runs on port 8081 (Docker uses 8080 locally).
############################################################

### Get all tickets from MongoDB
GET http://localhost:8081/api/tickets


### Get one existing ticket by id
# Replace the ID below with an actual _id returned by GET /api/tickets
GET http://localhost:8081/api/tickets/REPLACE_WITH_REAL_ID


### Get a missing ticket -> 404
GET http://localhost:8081/api/tickets/000000000000000000000000


### Create a valid ticket -> 201 (saved to MongoDB)
POST http://localhost:8081/api/tickets
Content-Type: application/json

{
  "title": "VPN connection not working",
  "description": "User cannot connect to company VPN from home.",
  "category": "Network",
  "priority": "MEDIUM",
  "createdBy": "siti@example.com"
}


### Create an invalid ticket - all blank -> 400
POST http://localhost:8081/api/tickets
Content-Type: application/json

{
  "title": "",
  "description": "",
  "category": "",
  "priority": "",
  "createdBy": ""
}
